# 大模型
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen-vl-max
QWEN_MODEL=qwen-max

# 地图服务: amap | nominatim | google
MAP_SERVICE=nominatim
MAP_SERVICE_FALLBACK=amap
AMAP_SERVER_KEY=
AMAP_WEB_KEY=
# 预留配置，当前版本尚未实现 Google Maps provider。
GOOGLE_MAPS_API_KEY=
TENCENT_MAP_KEY=

# 搜索服务: serpapi | bing
SEARCH_SERVICE=bing
SERPAPI_API_KEY=
BING_SEARCH_API_KEY=

# 以图搜图: bing_visual | none
REVERSE_IMAGE_SERVICE=none
# 预留配置，当前 PicImageSearch 集成不读取此变量。
BING_VISUAL_API_KEY=

# 应用
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20
MAX_REACT_LOOPS=4
REACT_TOP_K=5
MAX_TOTAL_TOOL_CALLS=24
MAX_TOOL_ELAPSED_SECONDS=120
TOOL_TIMEOUT_SECONDS=20
WORKER_POOL_SIZE=4
TASK_TIMEOUT_SECONDS=420
UPLOAD_TTL_SECONDS=1800
MAX_IMAGE_PIXELS=50000000
MODEL_OFFLINE=false
PRELOAD_MODELS=false

# Optional model cache location. Leave unset to use %USERPROFILE%\.cache\huggingface.
# HF_HOME=C:\Users\your-name\.cache\huggingface

# 安全预检
SAFETY_FACE_MAX_COUNT=3
# signal keeps Haar as a warning; reject enables legacy hard rejection.
SAFETY_FACE_POLICY=signal
SAFETY_DELETE_IMAGE_AFTER_DONE=true
SAFETY_REQUIRE_API=true
# OCR is optional on Windows. Set true only when OCR must be fail-closed.
SAFETY_REQUIRE_OCR=false

# Optional capabilities can be disabled while Windows model packages are not installed.
GEOCLIP_ENABLED=true
CLIP_SEARCH_ENABLED=true
CLIP_DB_PATH=./data/geo_image_db_v2

# Ranking weights are uncalibrated until CALIBRATION_PATH points at an evaluated artifact.
RANK_WEIGHT_GEOCLIP=0.25
RANK_WEIGHT_CLIP=0.20
RANK_WEIGHT_OCR=0.28
RANK_WEIGHT_VISION=0.17
RANK_WEIGHT_KNOWLEDGE=0.10
CALIBRATION_PATH=
MODEL_COST_PER_1K_TOKENS=0

# 限流
RATE_LIMIT=10/minute
