# 大模型
QWEN_API_KEY=sk-xxxxxxxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen-vl-max
QWEN_MODEL=qwen-max

# 地图服务: amap | nominatim | google
MAP_SERVICE=nominatim
MAP_SERVICE_FALLBACK=amap
AMAP_API_KEY=xxxxxxxx
GOOGLE_MAPS_API_KEY=xxxxxxxx

# 搜索服务: serpapi | bing
SEARCH_SERVICE=bing
SERPAPI_API_KEY=xxxxxxxx
BING_SEARCH_API_KEY=xxxxxxxx

# 以图搜图: bing_visual | none
REVERSE_IMAGE_SERVICE=none
BING_VISUAL_API_KEY=xxxxxxxx

# 应用
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20
MAX_REACT_LOOPS=10
WORKER_POOL_SIZE=4
TASK_TIMEOUT_SECONDS=120

# 安全预检
SAFETY_FACE_MAX_COUNT=3
SAFETY_DELETE_IMAGE_AFTER_DONE=true

# 限流
RATE_LIMIT=10/minute
